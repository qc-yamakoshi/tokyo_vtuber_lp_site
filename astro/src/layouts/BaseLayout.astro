---
import "../styles/global.css";
const {
  title = "東京VTuber不動産｜オンライン物件相談",
  description = "東京VTuber不動産は、VTuber相談員とオンラインで話しながら物件探しができる不動産相談サービスです。",
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline src="/main.js"></script>
  </body>
</html>
